# 统一文本行尾，二进制资源保持原始字节。
* text=auto eol=lf

# 二进制：不要做任何行尾或编码转换。
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.otf  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.so   binary
*.dll  binary
*.a    binary
*.exe  binary
*.zip  binary

# Windows 批处理使用 CRLF。
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 锁文件与生成物不参与 diff 折叠统计（它们本来就不该被人工阅读）。
*.lock       linguist-generated=true

# 第三方许可证保留上游原文。
/desktop/THIRD_PARTY_NOTICES.md -whitespace
