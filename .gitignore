# Flutter and Dart caches; generated bridge and plugin sources stay tracked.
.dart_tool/
.pub/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
coverage/
.widget_preview/

# Rust build artifacts; Cargo.lock stays tracked.
/rust/target/

# CMake and Ninja build state.
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
cmake_install.cmake
install_manifest.txt
compile_commands.json
.ninja_deps
.ninja_log

# Python tool caches and coverage.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Editor and local workspace state.
*.iml
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# Local environment values; share only example files.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Logs and operating-system metadata.
*.log
.DS_Store
Thumbs.db
Desktop.ini

# Local-only project scratch directories.
/.demo
/.plan

# Local-only redirect of flutter_sangfor to the sibling fork checkout.
pubspec_overrides.yaml
