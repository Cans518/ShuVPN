# Local build and verification output.
build/
coverage/

# Rust build artifacts; Cargo.lock stays tracked.
/target/
/crates/*/target/
/third_party/sangfor/target/
/desktop/src-tauri/target/
/desktop/node_modules/
/desktop/dist/
/desktop/src-tauri/gen/schemas/

# CMake and Ninja build state.
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
cmake_install.cmake
install_manifest.txt
compile_commands.json
.ninja_deps
.ninja_log

# Python tool caches and coverage.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Editor and local workspace state.
*.iml
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# Local environment values; share only example files.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Logs and operating-system metadata.
*.log
.DS_Store
Thumbs.db
Desktop.ini
